# --- Required ---
# Bearer token FlexDesk uses to call this service. Generate: openssl rand -hex 32
# Two comma-separated values are accepted so the key can be rotated without downtime.
GATEWAY_API_KEYS=
# 32 random bytes, base64. Encrypts WhatsApp credentials at rest. Generate: openssl rand -base64 32
# Losing or changing this key makes every stored session unreadable (schools must re-scan).
GATEWAY_ENCRYPTION_KEY=
# Where signed events are delivered (FlexDesk's webhook route). Must be https in production.
WEBHOOK_URL=
# Shared secret that signs webhooks (min 32 chars). Generate: openssl rand -hex 32
WEBHOOK_SECRET=
# Postgres connection string. On Supabase use the *session* pooler (port 5432), not the
# transaction pooler (6543): the leader lock needs a session-level connection.
DATABASE_URL=

# --- Optional ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
DB_SCHEMA=wa_gateway
DB_SSL=true
# PEM of the database's CA certificate. Without it the connection is encrypted but the server's
# identity is not verified.
DB_SSL_CA=
MAX_SESSIONS=20
# Only recipients who messaged the school within this many hours can be replied to.
REPLY_WINDOW_HOURS=24
