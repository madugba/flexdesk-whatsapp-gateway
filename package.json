{
  "name": "flexdesk-whatsapp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-session WhatsApp gateway for FlexDesk",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "migrate": "node dist/db/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "ws": "^8.23.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
